// link-depo.php — USER PANEL (Neon Style) — Full Featured
// -------------------------------------------------------
// Features:
// - DataTables (search + pagination 10/page)
// - Single Buy (AJAX)
// - Bulk Add (AJAX + modal-style inline form) [REMOVED]
// - Credit live update
// - Placement logging & receiver hook (best-effort)
// - Robust JSON endpoints (no BOM/whitespace leaks)
// - Shows only active rows (durum=1) but tolerates NULL for legacy rows
// - Auto-refresh when redirected from add_link.php?added=1
//
// NOTE: This file assumes header.php/footer.php already exist and setup $db + session.
//       This is user-facing (NOT admin).

include "header.php";
if (empty($_SESSION['user'])) { redirect("login.php"); exit(); }
$user = is_object($_SESSION['user']) ? $_SESSION['user'] : (object)$_SESSION['user'];
$uid  = (int)$user->id;

// ---------------------------
// Helpers
// ---------------------------
function esc($v){ return htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8'); }
function dbx($v){ global $db; return (isset($db) && method_exists($db,'escape')) ? $db->escape($v) : addslashes($v); }
function has_col($table, $col){
  static $cache = [];
  $key = $table.'|'.$col;
  if(isset($cache[$key])) return $cache[$key];
  global $db;
  try{
    $exists = (int)$db->get_var(
      "SELECT COUNT(*) FROM information_schema.columns 
       WHERE table_schema=DATABASE() AND table_name='".dbx($table)."' AND column_name='".dbx($col)."'"
    );
    return $cache[$key] = ($exists>0);
  }catch(Throwable $e){ return $cache[$key] = false; }
}
function json_exit($arr){
  if (!headers_sent()) {
    header('Content-Type: application/json; charset=utf-8');
    header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
  }
  echo json_encode($arr);
  exit;
}

// --------------------------------------
// SETTINGS / CONSTANTS (edit freely)
// --------------------------------------
$COST_PER_LINK = 1; // প্রতি লিংক ১ ক্রেডিট

// ---- Receiver (auto placement) placeholders (optional) ----
define('RECEIVER_URL', '');
define('RECEIVER_SECRET', '');

// --------------------------------------
// Ensure placement log table (best-effort)
// --------------------------------------
try{
  $GLOBALS['__k_lp_ok'] = $db->query("
    CREATE TABLE IF NOT EXISTS k_link_placements (
      id INT AUTO_INCREMENT PRIMARY KEY,
      uid INT NOT NULL,
      lid INT NOT NULL,
      domain VARCHAR(255),
      target_url VARCHAR(255),
      keyword VARCHAR(255),
      status ENUM('pending','success','failed') DEFAULT 'pending',
      api_response TEXT,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
  ");
}catch(Throwable $e){ /* ignore */ }

// --------------------------------------
// USER CREDIT
// --------------------------------------
$credit = 0;
try { $credit = (int)$db->get_var("SELECT kredi FROM k_users WHERE id='{$uid}'"); } catch(Throwable $e){ $credit = 0; }

// --------------------------------------
// Build SELECT columns (optional columns safe)
// --------------------------------------
$cols = "id, domain, link, tip, durum, ups, alexa1, alexa2";
$has_year     = has_col('k_linkdb','domain_year');
$has_sure     = has_col('k_linkdb','sure');
$has_added    = has_col('k_linkdb','created_at');
$has_added2   = has_col('k_linkdb','added_at');
$has_country  = has_col('k_linkdb','country');

if ($has_year)   $cols .= ", domain_year";
if ($has_sure)   $cols .= ", sure";
if ($has_added)  $cols .= ", created_at";
if ($has_added2) $cols .= ", added_at";
if ($has_country)$cols .= ", country";

// --------------------------------------
// Stats (optional informational cards)
// --------------------------------------
$totalLinks  = (int)$db->get_var("SELECT COUNT(*) FROM k_linkdb");
$totalCredit = (int)$db->get_var("SELECT COALESCE(SUM(ups),0) FROM k_linkdb");
$phpCount    = (int)$db->get_var("SELECT COUNT(*) FROM k_linkdb WHERE tip=1");
$jsCount     = (int)$db->get_var("SELECT COUNT(*) FROM k_linkdb WHERE tip=2");

// --------------------------------------
// Rows (active first; tolerate NULL for legacy)
// --------------------------------------
$rows = $db->get_results("SELECT {$cols} FROM k_linkdb WHERE durum='1' OR durum IS NULL ORDER BY id DESC LIMIT 500");

// --------------------------------------
// Already purchased by this user
// --------------------------------------
$purchased_ids = $db->get_col("
  SELECT l.id
  FROM k_orders o
  LEFT JOIN k_linkdb l ON l.id=o.lid
  WHERE o.uid='{$uid}'
");
$purchased_set = [];
if ($purchased_ids) { foreach($purchased_ids as $lid) $purchased_set[(int)$lid] = true; }

// --------------------------------------
// Auto Placement to receiver (best-effort)
// --------------------------------------
function auto_place_link($lid, $domain, $target_url, $keyword){
  global $db, $uid;
  try{
    $db->query("INSERT INTO k_link_placements (uid,lid,domain,target_url,keyword,status,created_at) 
      VALUES ('{$uid}','{$lid}','".dbx($domain)."','".dbx($target_url)."','".dbx($keyword)."','pending',NOW())");
    $plc_id = (int)$db->insert_id;
  }catch(Throwable $e){ $plc_id = 0; }

  if (!RECEIVER_URL) {
    if ($plc_id){
      $db->query("UPDATE k_link_placements SET status='failed', api_response='Receiver URL not configured' WHERE id='{$plc_id}'");
    }
    return false;
  }

  $payload = [
    'secret'     => RECEIVER_SECRET,
    'operation'  => 'place_link',
    'domain'     => $domain,
    'target_url' => $target_url,
    'keyword'    => $keyword
  ];

  $resp = null;
  $ok   = false;
  try{
    $ch = curl_init();
    curl_setopt_array($ch, [
      CURLOPT_URL => RECEIVER_URL,
      CURLOPT_POST => true,
      CURLOPT_POSTFIELDS => http_build_query($payload),
      CURLOPT_RETURNTRANSFER => true,
      CURLOPT_TIMEOUT => 15,
      CURLOPT_SSL_VERIFYPEER => false,
      CURLOPT_SSL_VERIFYHOST => false,
      CURLOPT_HTTPHEADER => ['Expect:']
    ]);
    $resp = curl_exec($ch);
    $err  = curl_error($ch);
    $http = (int)curl_getinfo($ch, CURLINFO_HTTP_CODE);
    curl_close($ch);

    if ($err) {
      $ok = false;
      $resp = "cURL error: ".$err;
    } else {
      $data = json_decode($resp,true);
      $ok = (is_array($data) && !empty($data['ok']));
    }
  } catch(Throwable $e){
    $ok = false;
    $resp = "Exception: ".$e->getMessage();
  }

  if ($plc_id){
    $st = $ok ? 'success' : 'failed';
    $db->query("UPDATE k_link_placements SET status='{$st}', api_response='".dbx((string)$resp)."' WHERE id='{$plc_id}'");
  }

  return $ok;
}

// ======================================================================
// AJAX ENDPOINTS
// ======================================================================
if (!empty($_GET['ajax'])) {

  // ---- AJAX: individual buy ----
  if ($_GET['ajax']==='buy' && $_SERVER['REQUEST_METHOD']==='POST') {
    try {
      $lid = (int)($_POST['lid'] ?? 0);
      if ($lid <= 0) json_exit(['ok'=>0,'msg'=>'Invalid link id']);

      $already = (int)$db->get_var("SELECT COUNT(*) FROM k_orders WHERE uid='{$uid}' AND lid='{$lid}'");
      if ($already > 0) json_exit(['ok'=>0,'msg'=>'Already purchased']);

      $lr = $db->get_row("SELECT id, domain FROM k_linkdb WHERE id='{$lid}'");
      if (!$lr) json_exit(['ok'=>0,'msg'=>'Link not found']);

      $bal = (int)$db->get_var("SELECT kredi FROM k_users WHERE id='{$uid}'");
      if ($bal < $COST_PER_LINK) json_exit(['ok'=>0,'msg'=>'Insufficient credits','balance'=>$bal]);

      $db->query("INSERT INTO k_orders (uid,lid,tarih) VALUES ('{$uid}','{$lid}',NOW())");
      $db->query("UPDATE k_users SET kredi = kredi - {$COST_PER_LINK} WHERE id='{$uid}'");
      $newBal = (int)$db->get_var("SELECT kredi FROM k_users WHERE id='{$uid}'");

      auto_place_link($lid, $lr->domain, '', '');

      json_exit(['ok'=>1,'msg'=>'Purchased successfully','lid'=>$lid,'new_balance'=>$newBal]);
    } catch(Throwable $e){
      json_exit(['ok'=>0,'msg'=>'Server error: '.$e->getMessage()]);
    }
  }

  // ---- AJAX: Bulk add (final submit) [REMOVED] ----
  /*
  if ($_GET['ajax']==='bulk' && $_SERVER['REQUEST_METHOD']==='POST') {
    try {
      $ids = $_POST['ids'] ?? [];
      if (!is_array($ids)) $ids = [];
