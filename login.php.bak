<?php
// login.php
session_start();
include "config.php"; // এখানে $pdo থাকবে (PDO কানেকশন)

// Helper function (নাম আলাদা: post_input)
function post_input($k){
    return isset($_POST[$k]) ? trim($_POST[$k]) : '';
}

$error   = '';
$success = '';

// ---------------- LOGIN ----------------
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $action = post_input('action');

    // Login form
    if ($action === 'login') {
        $username = post_input('username');
        $password = post_input('password');

        if ($username === '' || $password === '') {
            $error = "Both fields are required!";
        } else {
            $stmt = $pdo->prepare("SELECT * FROM k_users WHERE username = ? OR email = ? LIMIT 1");
            $stmt->execute([$username, $username]);
            $user = $stmt->fetch(PDO::FETCH_ASSOC);

            if ($user && password_verify($password, $user['password'])) {
                $_SESSION["user"] = [
                    'id'       => $user['id'],
                    'username' => $user['username'],
                    'email'    => $user['email'],
                    'name'     => $user['name'] ?? '',
                    'country'  => $user['country'] ?? ''
                ];
                header("Location: index.php");
                exit;
            } else {
                $error = "Invalid credentials!";
            }
        }
    }

    // Forgot username
    if ($action === 'forgot_username') {
        $fu_email = filter_var(post_input('fu_email'), FILTER_VALIDATE_EMAIL);
        $success  = 'If that email exists, the username has been sent.';

        if ($fu_email) {
            $stmt = $pdo->prepare("SELECT username,email FROM k_users WHERE email=? LIMIT 1");
            $stmt->execute([$fu_email]);
            $row = $stmt->fetch(PDO::FETCH_ASSOC);

            if ($row) {
                $to      = $row['email'];
                $subject = "Your username";
                $message = "Hello,\n\nYour username: {$row['username']}\n\nIf you did not request this, ignore this email.";
                $headers = "From: no-reply@" . $_SERVER['HTTP_HOST'];
                @mail($to, $subject, $message, $headers);
            }
        }
    }

    // Forgot password
    if ($action === 'forgot_password') {
        $fp_email = filter_var(post_input('fp_email'), FILTER_VALIDATE_EMAIL);
        $success  = 'If that email exists, a reset link has been sent.';

        if ($fp_email) {
            $token   = bin2hex(random_bytes(16));
            $expires = (new DateTime('+1 hour'))->format('Y-m-d H:i:s');

            $pdo->prepare("INSERT INTO password_resets (email, token, expires_at) VALUES (?,?,?)")
                ->execute([$fp_email, $token, $expires]);

            $stmt = $pdo->prepare("SELECT email FROM k_users WHERE email=? LIMIT 1");
            $stmt->execute([$fp_email]);
            $row = $stmt->fetch(PDO::FETCH_ASSOC);

            if ($row) {
                $scheme    = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
                $host      = $_SERVER['HTTP_HOST'];
                $resetLink = "{$scheme}://{$host}/auth/reset_password.php?token={$token}";

                $to      = $row['email'];
                $subject = "Password reset";
                $message = "Click this link to reset your password (valid 1 hour):\n\n{$resetLink}\n\nIf you did not request this, ignore this email.";
                $headers = "From: no-reply@{$host}";
                @mail($to, $subject, $message, $headers);
            }
        }
    }
}
?>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Login - HackLink Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-dark d-flex align-items-center" style="height:100vh;">
<div class="container">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      <div class="row g-4">

        <!-- Login Form -->
        <div class="col-md-4">
          <div class="card shadow-lg">
            <div class="card-header bg-primary text-white text-center fw-bold">HackLink Login</div>
            <div class="card-body">
              <?php if($error): ?>
                <div class="alert alert-danger"><?= $error ?></div>
              <?php endif; ?>
              <?php if($success && !$error): ?>
                <div class="alert alert-success"><?= $success ?></div>
              <?php endif; ?>
              <form method="post">
                <input type="hidden" name="action" value="login">
                <div class="mb-3">
                  <label class="form-label">Username or Email</label>
                  <input type="text" name="username" class="form-control" required>
                </div>
                <div class="mb-3">
                  <label class="form-label">Password</label>
                  <input type="password" name="password" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-primary w-100">Login</button>
              </form>
              <div class="mt-3 text-center">
                Don’t have an account? <a href="register.php">Register here</a>
              </div>
              <div class="mt-2 text-center">
                <a href="#forgot" class="small text-decoration-underline text-muted" onclick="document.getElementById('forgot-forms').scrollIntoView({behavior:'smooth'});">Forgot username / password?</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Forgot forms -->
        <div class="col-md-8">
          <div id="forgot-forms" class="card shadow-lg">
            <div class="card-header bg-light fw-bold">Recover Account</div>
            <div class="card-body">
              <h5>Forgot Username</h5>
              <form method="post" class="mb-4">
                <input type="hidden" name="action" value="forgot_username">
                <div class="input-group">
                  <input type="email" name="fu_email" class="form-control" placeholder="Your email" required>
                  <button class="btn btn-outline-primary">Send Username</button>
                </div>
              </form>

              <hr>

              <h5>Forgot Password</h5>
              <form method="post">
                <input type="hidden" name="action" value="forgot_password">
                <div class="input-group">
                  <input type="email" name="fp_email" class="form-control" placeholder="Your email" required>
                  <button class="btn btn-warning">Send Reset Link</button>
                </div>
              </form>
              <p class="small text-muted mt-3">⚠️ Security: We always show same message to prevent enumeration. Check your email (and spam folder).</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
