<!-- Buy Modal -->
<div class="modal fade" id="buyModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title">Buy Link Placement</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <form id="buyForm">
                    <input type="hidden" name="lid" id="modalLid">
                    <div class="mb-3"><label>Target URL</label>
                        <input type="url" name="target_url" id="modalTarget" class="form-control" placeholder="https://your-site.com/article" required>
                    </div>
                    <div class="mb-3"><label>Keyword (Anchor)</label>
                        <input type="text" name="keyword" id="modalKeyword" class="form-control" placeholder="anchor text">
                    </div>
                </form>
                <div id="buyAlert"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="confirmBuy" class="btn btn-success">Confirm Buy</button>
            </div>
        </div>
    </div>
</div>

<?php include "footer.php"; ?>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.4/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
(function(){
    // Utility to decode HTML entities
    function decodeHtml(html) {
        const txt = document.createElement('textarea');
        txt.innerHTML = html;
        return txt.value;
    }

    // DataTable: 15 per page + search box
    $.fn.dataTable.ext.search.push(
        function(settings, data, dataIndex) {
            const searchTerm = $('#marketTable_filter input').val().trim().toLowerCase();
            if (!searchTerm) return true;
            const row = table.row(dataIndex).node();
            const domain = decodeHtml($(row).attr('data-domain') || '').trim().toLowerCase();
            return domain.includes(searchTerm);
        }
    );

    const table = $('#marketTable').DataTable({
        pageLength: 15,
        order: [[0, "desc"]],
        language: {
            searchPlaceholder: 'Search domains...',
        },
        search: {
            caseInsensitive: true
        }
    });

    $('#marketTable_filter input').on('input', function() {
        table.draw();
    });

    // Checkbox logic
    const $chkAll = $('#chkAll');
    const $btnBulk = $('#btnBulkAdd');

    function refreshBulkState() {
        const count = $('.rowChk:enabled:checked').length;
        $btnBulk.prop('disabled', count === 0);
        $('#bulkSelectedCount').text(count);
    }

    $chkAll.on('change', function() {
        const checked = $(this).is(':checked');
        $('.rowChk:enabled').prop('checked', checked);
        refreshBulkState();
    });

    $(document).on('change', '.rowChk', refreshBulkState);

    // Open Bulk Modal
    const bulkModal = new bootstrap.Modal('#bulkModal');
    $btnBulk.on('click', function() {
        $('#bulkAlert').html('');
        $('#bulkSiteAddress').val('');
        $('#bulkKeyword').val('');
        $('#bulkDuration').val('1m');
        refreshBulkState();
        bulkModal.show();
    });

    function getSelectedIds() {
        return $('.rowChk:enabled:checked').map((_, el) => $(el).val()).get();
    }

    // Bulk Process
    $('#confirmBulkBtn').on('click', function() {
        const ids = getSelectedIds();
        const site_address = $('#bulkSiteAddress').val().trim();
        const keyword = $('#bulkKeyword').val().trim();
        const duration = $('#bulkDuration').val();
        if (ids.length === 0) {
            $('#bulkAlert').html('<div class="alert alert-warning">Select at least one site.</div>');
            return;
        }
        if (!site_address) {
            $('#bulkAlert').html('<div class="alert alert-warning">Please enter Target URL.</div>');
            return;
        }

        $('#confirmBulkBtn').prop('disabled', true).text('Processing...');
        $('#bulkAlert').html('<div class="alert alert-info">Processing, please wait...</div>');

        $.ajax({
            url: 'link-depo.php?ajax=bulk',
            method: 'POST',
            dataType: 'json',
            timeout: 45000,
            data: { ids: ids, site_address: site_address, keyword: keyword, duration: duration },
            success: function(res) {
                console.log('Bulk add response:', res);
                if (!res || !res.ok) {
                    $('#bulkAlert').html('<div class="alert alert-danger">'+(res && res.msg ? res.msg : 'Failed')+'</div>');
                    return;
                }
                (res.purchased || []).forEach(function(lid) {
                    const row = $('tr[data-lid="'+lid+'"]');
                    row.find('.buy-btn').replaceWith('<span class="lock-badge">Purchased 🔒</span>');
                    row.find('.rowChk').prop('checked', false).prop('disabled', true);
                });
                if (typeof res.new_balance !== 'undefined') {
                    $('#liveCreditBadge').text(res.new_balance);
                }
                const purchasedN = (res.purchased || []).length;
                const skippedN = (res.skipped || []).length;
                $('#bulkAlert').html('<div class="alert alert-success">✅ Bulk added '+purchasedN+' link(s), skipped '+skippedN+'.</div>');
                $('#chkAll').prop('checked', false);
                refreshBulkState();
                setTimeout(() => bulkModal.hide(), 1500);
            },
            error: function(xhr, status, error) {
                let errMsg = 'Network or server error. ';
                if (xhr.responseText) errMsg += xhr.responseText.substring(0, 200);
                $('#bulkAlert').html('<div class="alert alert-danger">'+errMsg+'</div>');
                console.error('Bulk add error:', errMsg);
            },
            complete: function() {
                $('#confirmBulkBtn').prop('disabled', false).text('Process');
            }
        });
    });

    // Single Buy — open modal
    const buyModal = new bootstrap.Modal('#buyModal');
    $(document).on('click', '.buy-btn', function(e) {
        e.preventDefault();
        const lid = $(this).data('lid');
        const domain = $(this).data('domain');
        $('#modalLid').val(lid);
        $('#buyModal .modal-title').text('Buy Link: ' + decodeHtml(domain));
        $('#modalTarget').val('');
        $('#modalKeyword').val('');
        $('#buyAlert').html('');
        buyModal.show();
    });

    // Single Buy — confirm
    $('#confirmBuy').on('click', function() {
        const target_url = $('#modalTarget').val().trim();
        if (!target_url) {
            $('#buyAlert').html('<div class="alert alert-warning">Please enter Target URL.</div>');
            return;
        }

        const data = $('#buyForm').serialize();
        const lid = $('#modalLid').val();
        $('#confirmBuy').prop('disabled', true).text('Processing...');
        $('#buyAlert').html('<div class="alert alert-info">Working...</div>');

        $.ajax({
            url: 'link-depo.php?ajax=buy',
            method: 'POST',
            dataType: 'json',
            timeout: 30000,
            data: data,
            success: function(res) {
                console.log('Buy response:', res);
                if (res && res.ok) {
                    const row = $('tr[data-lid="'+lid+'"]');
                    row.find('.buy-btn').replaceWith('<span class="lock-badge">Purchased 🔒</span>');
                    row.find('.rowChk').prop('checked', false).prop('disabled', true);
                    if (typeof res.new_balance !== 'undefined') {
                        $('#liveCreditBadge').text(res.new_balance);
                    }
                    $('#buyAlert').html('<div class="alert alert-success">✅ '+res.msg+(res.placed?' (Placed)':'')+'</div>');
                    setTimeout(() => buyModal.hide(), 1200);
                } else {
                    $('#buyAlert').html('<div class="alert alert-danger">⚠️ '+(res && res.msg ? res.msg : 'Purchase failed')+'</div>');
                }
            },
            error: function(xhr, status, error) {
                let msg = 'Network or server error.';
                if (xhr.responseText) msg += ' '+xhr.responseText.substring(0, 200);
                $('#buyAlert').html('<div class="alert alert-danger">'+msg+'</div>');
                console.error('Buy error:', msg);
            },
            complete: function() {
                $('#confirmBuy').prop('disabled', false).text('Confirm Buy');
            }
        });
    });

    // Poll for new links
    let lastId = Math.max(...$('tr[data-lid]').map((_, el) => parseInt($(el).attr('data-lid'))).get(), 0);
    console.log('Initial lastId:', lastId);

    function pollNewLinks() {
        console.log('Polling for new links with lastId:', lastId);
        $.ajax({
            url: 'link-depo.php?ajax=new_links&last_id=' + lastId,
            method: 'GET',
            dataType: 'json',
            timeout: 10000,
            success: function(res) {
                console.log('Poll response:', res);
                if (res && res.ok && res.links && res.links.length > 0) {
                    console.log('Adding', res.links.length, 'new links');
                    res.links.forEach(function(link) {
                        const typeBadge = link.tip == 1 ? '<span class="badge badge-php">PHP</span>' :
                                         link.tip == 2 ? '<span class="badge badge-js">JS</span>' :
                                         '<span class="badge bg-secondary">Other</span>';
                        const rowHtml = `
                            <tr data-lid="${link.id}" data-domain="${decodeHtml(link.domain)}">
                                <td><input type="checkbox" class="rowChk" value="${link.id}" ${link.is_purchased ? 'disabled' : ''}></td>
                                <td><span class="fw-bold">${decodeHtml(link.domain)}</span></td>
                                <td>${link.alexa1 || 0}</td>
                                <td>${link.alexa2 || 0}</td>
                                <td><?php echo $COST_PER_LINK; ?></td>
                                <td>${typeBadge}</td>
                                <td>${link.domain_year || '–'}</td>
                                <td>${link.sure || '–'}</td>
                                <td>${link.country || '–'}</td>
                                <td>${link.created_at || '–'}</td>
                                <td>
                                    ${link.is_purchased ? '<span class="lock-badge">Purchased 🔒</span>' :
                                      `<button class="btn btn-sm btn-primary buy-btn" data-lid="${link.id}" data-domain="${decodeHtml(link.domain)}">
                                          🪙 Buy (<?php echo $COST_PER_LINK; ?>)
                                      </button>`}
                                </td>
                            </tr>`;
                        table.row.add($(rowHtml)).draw(false);
                        console.log('Added row for link ID:', link.id);
                        if (link.id > lastId) lastId = link.id;
                    });
                    console.log('Updated lastId to:', lastId);
                    // Update stats
                    $.ajax({
                        url: 'link-depo.php?ajax=stats',
                        method: 'GET',
                        dataType: 'json',
                        success: function(stats) {
                            if (stats && stats.ok) {
                                $('.stats-box.text-info').text(stats.totalLinks);
                                $('.stats-box.text-success').text(stats.totalCredit);
                                $('.badge.badge-php').text(stats.phpCount);
                                $('.badge.badge-js').text(stats.jsCount);
                                console.log('Stats updated:', stats);
                            }
                        },
                        error: function(xhr, status, error) {
                            console.error('Stats update error:', status, error, xhr.responseText);
                        }
                    });
                } else {
                    console.log('No new links found or invalid response:', res);
                }
            },
            error: function(xhr, status, error) {
                console.error('Poll error:', status, error, xhr.responseText);
            },
            complete: function() {
                console.log('Scheduling next poll in 30s');
                setTimeout(pollNewLinks, 30000);
            }
        });
    }
    setTimeout(pollNewLinks, 5000);
})();
</script>
</body>
</html>